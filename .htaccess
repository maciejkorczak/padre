# padreguilherme.pl — konfiguracja Apache (home.pl, strona w katalogu głównym serwera)

# Zawsze HTTPS i adres bez www (jeden adres = lepsze SEO).
# Reguły działają tylko dla padreguilherme.pl, więc na adresie testowym nic nie przekierowują.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Krótki adres dla kampanii (Marek, 20.10.2026): /bilety -> sprzedaż biletów z linkiem partnera L2L.
  # Przed regułami https/www, więc z każdego wariantu adresu to jeden krok.
  # 1) Normalnie: bilety.php przekierowuje (302) z partner=l2lsp, utm_* z linku (utm_source=direct, gdy brak),
  #    fbclid/gclid, i zapisuje wejście do statystyk (/statystyki/, bez IP i bez ciasteczek).
  RewriteCond %{HTTP_HOST} ^(www\.)?padreguilherme\.pl$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/bilety.php -f [OR]
  RewriteCond %{CONTEXT_DOCUMENT_ROOT}/bilety.php -f
  RewriteRule ^bilety/?$ /bilety.php [NC,END]
  # 2) Awaryjnie (gdy nie ma bilety.php): przekierowanie bez statystyk, z wszystkimi parametrami z linku
  #    (utm_*, fbclid, gclid...); utm_source=direct tylko, gdy link go nie ma.
  # Adres eBilet bez „/” przed „?”: wersja z ukośnikiem przekierowuje w eBilet i gubi utm_source.
  # 302 (tymczasowe): przeglądarki nie zapamiętują celu na stałe. NE: „#” zostaje „#”.
  RewriteCond %{HTTP_HOST} ^(www\.)?padreguilherme\.pl$ [NC]
  RewriteCond %{QUERY_STRING} (?:^|&)utm_source= [NC]
  RewriteRule ^bilety/?$ "https://www.ebilet.pl/muzyka/elektro-techno/padre-guilherme?partner=l2lsp&%{QUERY_STRING}#padre-guilherme_155685,1622" [NC,NE,R=302,L]
  RewriteCond %{HTTP_HOST} ^(www\.)?padreguilherme\.pl$ [NC]
  RewriteCond %{QUERY_STRING} .
  RewriteRule ^bilety/?$ "https://www.ebilet.pl/muzyka/elektro-techno/padre-guilherme?partner=l2lsp&utm_source=direct&%{QUERY_STRING}#padre-guilherme_155685,1622" [NC,NE,R=302,L]
  RewriteCond %{HTTP_HOST} ^(www\.)?padreguilherme\.pl$ [NC]
  RewriteRule ^bilety/?$ "https://www.ebilet.pl/muzyka/elektro-techno/padre-guilherme?partner=l2lsp&utm_source=direct#padre-guilherme_155685,1622" [NC,NE,R=302,L]

  RewriteCond %{HTTP_HOST} ^www\.padreguilherme\.pl$ [NC]
  RewriteRule ^ https://padreguilherme.pl%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^padreguilherme\.pl$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://padreguilherme.pl%{REQUEST_URI} [L,R=301]
  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [L,R=301]
</IfModule>

# Typy plików (AVIF i fonty bywają serwowane bez Content-Type)
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddDefaultCharset utf-8
  AddCharset utf-8 .html .css .js .xml .txt
</IfModule>

# Kompresja
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache tylko dla plików tej strony (/assets/ i strona główna).
# Inne foldery na serwerze (np. ebiletconfidential) zostają z domyślnym cache.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/(index\.html)?$#">
    Header set Cache-Control "no-cache"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Przeglądarka zapamiętuje, że strona działa tylko po HTTPS (rok). Bez includeSubDomains.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Strony nie da się osadzić w ramce na cudzej stronie (ochrona przed clickjackingiem).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Bez listowania katalogów i bez dostępu do plików ukrytych
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
