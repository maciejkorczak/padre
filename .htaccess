# padreguilherme.pl — konfiguracja Apache (home.pl, strona w katalogu głównym serwera)

# Zawsze HTTPS i adres bez www (jeden adres = lepsze SEO).
# Reguły działają tylko dla padreguilherme.pl, więc na adresie testowym nic nie przekierowują.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.padreguilherme\.pl$ [NC]
  RewriteRule ^ https://padreguilherme.pl%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^padreguilherme\.pl$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://padreguilherme.pl%{REQUEST_URI} [L,R=301]
  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [L,R=301]
</IfModule>

# Typy plików (AVIF i fonty bywają serwowane bez Content-Type)
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddDefaultCharset utf-8
  AddCharset utf-8 .html .css .js .xml .txt
</IfModule>

# Kompresja
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache tylko dla plików tej strony (/assets/ i strona główna).
# Inne foldery na serwerze (np. ebiletconfidential) zostają z domyślnym cache.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/(index\.html)?$#">
    Header set Cache-Control "no-cache"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Przeglądarka zapamiętuje, że strona działa tylko po HTTPS (rok). Bez includeSubDomains.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Strony nie da się osadzić w ramce na cudzej stronie (ochrona przed clickjackingiem).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Bez listowania katalogów i bez dostępu do plików ukrytych
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
